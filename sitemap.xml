---
layout: null
permalink: /sitemap.xml
sitemap: false
---
{%- comment -%}
  Sitemap ditulis sendiri, bukan memakai jekyll-sitemap, karena situs ini
  punya lima versi bahasa untuk tiap halaman. Google membutuhkan anotasi
  xhtml:link di dalam tiap <url> agar tahu bahwa kelimanya adalah halaman
  yang sama dalam bahasa berbeda; plugin bawaan tidak menuliskannya.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign pages = site.pages | where_exp: "p", "p.alternates" | sort: "url" -%}
{%- for page in pages %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    {%- for alt in page.alternates %}
    <xhtml:link rel="alternate" hreflang="{{ alt.html_lang }}" href="{{ alt.url | absolute_url }}"/>
    {%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ page.alternates[0].url | absolute_url }}"/>
    {%- if page.page_id == "home" %}
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    {%- elsif page.page_id == "catalog" or page.page_id == "heritage" %}
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
    {%- else %}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
